# Database Configuration
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=my_database

# Logging
LOG_LEVEL=DEBUG
SQL_LOG=False

# JWT Auth
JWT_SECRET=supersecretkey_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Extraction (optional)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_REQUEST_TIMEOUT=180

# Email / Brevo Transactional API
EMAIL_REQUEST_TIMEOUT_SECONDS=30
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=1.0

BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_FROM_EMAIL=no-reply@your-domain.com
BREVO_FROM_NAME=My App
BREVO_REPLY_TO_EMAIL=support@your-domain.com
BREVO_REPLY_TO_NAME=My App Support
OTP_EXPIRE_MINUTES=15
